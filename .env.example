# KCMVP 사전 적합성 검증 도구 — 환경 변수 예시
# .env 로 복사 후 값 채우기

# API
API_V1_PREFIX=/api

# CORS (프론트 개발 주소)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 스토리지
STORAGE_ROOT=./storage
JOB_DATA_DIR=jobs

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# LLM (OpenAI)
OPENAI_API_KEY=sk-...

# RAG
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
CHROMA_PERSIST_DIR=./data/chroma

# Google Gemini (L3 LLM 판정용)
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_L3_MODEL=gemini-1.5-flash

# L3 제공자: "gemini" (기본) 또는 "local"
L3_PROVIDER=gemini

# 로컬 LLM — llama.cpp HTTP 서버 (Pattern A)
# 서버 실행: llama-server -m /path/to/model.gguf --port 8080 --host 0.0.0.0
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=kcmvp-judge
LOCAL_LLM_MAX_TOKENS=1024
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_TIMEOUT=120

# 로컬 LLM — HuggingFace transformers (Pattern B, 선택)
# 설정 시 Pattern A보다 우선 사용
# LOCAL_LLM_HF_MODEL=./models/kcmvp-judge

# 선택
LLM_MODEL_L3=gpt-4o
LLM_MODEL_PATCH=gpt-4o
