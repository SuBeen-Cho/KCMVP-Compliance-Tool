{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "staged_pipeline_observations.schema.json",
  "title": "Need-gated staged pipeline observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "pricing", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "dataset"],
      "properties": {"system": {"type": "string", "minLength": 1}, "dataset": {"type": "string", "minLength": 1}, "seed": {"type": "integer", "minimum": 0}, "notes": {"type": "string"}}
    },
    "pricing": {
      "type": "object", "additionalProperties": false,
      "required": ["input_usd_per_million", "output_usd_per_million"],
      "properties": {"input_usd_per_million": {"type": "number", "minimum": 0}, "output_usd_per_million": {"type": "number", "minimum": 0}}
    },
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "stage", "route_partition", "integrity_gate", "evidence_required", "official_evidence_ids", "verifier", "final_disposition", "baseline_llm_calls", "actual_llm_calls", "input_tokens", "output_tokens", "latency_ms", "cost_usd"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "stage": {"enum": ["deterministic", "retrieval", "ai", "abstain"]},
        "route_partition": {"enum": ["selected_deterministic", "selected_retrieve", "skip", "unresolved"]},
        "integrity_gate": {"enum": ["pass", "route_missing", "forged", "live_mismatch"]},
        "evidence_required": {"type": "boolean"},
        "official_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "verifier": {"enum": ["pass", "fail", "not_applicable"]},
        "final_disposition": {"enum": ["accept", "reject", "abstain"]},
        "baseline_llm_calls": {"type": "integer", "minimum": 0}, "actual_llm_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "number", "minimum": 0}, "cost_usd": {"type": "number", "minimum": 0}
      }
    }
  }
}
